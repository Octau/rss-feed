# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Where the SQLite database is stored (defaults to ./data; the Docker image uses /data)
# DATA_DIR=data

# Logging
# Directory where daily log files (bot-YYYY-MM-DD.log) are written (defaults to storage/logs)
# LOG_DIR=storage/logs
# Number of daily log files to keep; older ones are deleted at rotation (defaults to 7)
# LOG_BACKUP_COUNT=7
# Minimum log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (defaults to INFO)
# LOG_LEVEL=INFO

# Poller / RSS tunables — all optional; shown values are the defaults.
# Floor for per-feed polling interval, in seconds
# MIN_INTERVAL=120
# Default polling interval for new feeds, in seconds (14400 = 4h)
# DEFAULT_INTERVAL=14400
# Max new entries announced per feed per cycle (flood guard)
# MAX_ITEMS_PER_POLL=5
# Pause between feed fetches within one poller cycle, in seconds
# FETCH_SPACING=1.0
# Pause between webhook sends, in seconds (Discord rate limiting)
# SEND_SPACING=1.0
# HTTP request timeout, in seconds
# FETCH_TIMEOUT=20
# Cap on the exponential backoff interval for failing feeds, in seconds
# MAX_BACKOFF=3600
# Feeds per page in /rss list
# PAGE_SIZE=5
# Embed color for announcements (hex, 0x prefix)
# RSS_COLOR=0xEE802F
# Embed color for failure alerts (hex, 0x prefix)
# ERROR_COLOR=0xE74C3C
